{
  "name": "docs",
  "version": "1.0.0",
  "packageManager": "pnpm@11.1.0",
  "description": "Documentation of the Warp Design System",
  "main": "index.js",
  "scripts": {
    "build": "NODE_ENV=production vitepress build docs",
    "check": "pnpm biome check --write .",
    "dev": "NODE_ENV=development vitepress dev docs",
    "format": "pnpm biome format --write .",
    "generate-frameworks": "node scripts/generate-frameworks.js",
    "lint:check": "pnpm biome lint .",
    "lint": "pnpm biome lint --write .",
    "review:docs": "node scripts/review-docs.mjs",
    "serve": "vitepress serve docs",
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:review-docs": "node --test scripts/review-docs.test.mjs",
    "prepare": "husky"
  },
  "type": "module",
  "license": "Apache-2.0",
  "devDependencies": {
    "@biomejs/biome": "2.2.5",
    "@itsy/okay": "0.0.4",
    "@unocss/core": "66.5.2",
    "@vueuse/core": "10.11.0",
    "@warp-ds/css": "2.4.1",
    "@warp-ds/elements": "2.11.0",
    "@warp-ds/preset-docs": "0.0.16",
    "@warp-ds/uno": "2.2.0",
    "@warp-ds/vue": "2.3.0",
    "camelcase": "8.0.0",
    "decamelize": "6.0.1",
    "husky": "9.1.7",
    "markdown-it": "14.3.0",
    "markdown-it-container": "4.0.0",
    "sass": "1.101.0",
    "unocss": "66.5.2",
    "vite": "5.3.5",
    "vite-svg-loader": "5.1.1",
    "vitepress": "1.6.4",
    "vitepress-plugin-llms": "1.12.1",
    "vue": "3.5.40"
  }
}
